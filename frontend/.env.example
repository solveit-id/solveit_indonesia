# Absolute public origin, no trailing slash (e.g. https://example.co.id).
# Leave empty until the domain is confirmed: canonical URLs, Open Graph URLs,
# and sitemap.xml are only emitted when this is set.
VITE_SITE_URL=

# Laravel API origin only (scheme, host, optional port; no path, query, or
# credentials), e.g. https://api.example.co.id. HTTPS is required except for
# http://localhost, http://127.0.0.1, or http://[::1] during development.
# Invalid values are ignored. See docs/api/inquiries.md.
VITE_API_BASE_URL=

# "Send through website" channel of the contact form (POST /api/v1/inquiries).
# On only when this is exactly "true" AND VITE_API_BASE_URL is valid. Keep it
# false in production until the owner approves the privacy notice, retention,
# hosting, database, and operational handling. VITE_* values are public (they
# are built into the bundle): never put secrets or Laravel credentials here.
VITE_INQUIRY_API_ENABLED=false

# Search Console verification token, added once the domain exists.
VITE_GOOGLE_SITE_VERIFICATION=
