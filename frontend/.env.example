# Absolute public origin, no trailing slash (e.g. https://example.co.id).
# Leave empty until the domain is confirmed: canonical URLs, Open Graph URLs,
# and sitemap.xml are only emitted when this is set.
VITE_SITE_URL=

# Laravel API base URL for the future integration phase (e.g. https://api.example.co.id).
# Unused until the backend exists; see docs/architecture/integration-plan.md.
VITE_API_BASE_URL=

# Search Console verification token, added once the domain exists.
VITE_GOOGLE_SITE_VERIFICATION=
