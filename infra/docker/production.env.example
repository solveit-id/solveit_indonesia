# Runtime configuration of the production backend (infra/docker/compose.prod.yaml).
# Copy to infra/docker/production.env (ignored by Git) and adjust. Not secret: credentials are
# Docker secrets (APP_KEY_FILE, DB_PASSWORD_FILE set by the Compose file), never values here.
# Every variable is documented in backend/.env.example and backend/README.md.
# The values below work unchanged for the local production smoke test (no domain exists).

APP_NAME="Solveit Indonesia"
APP_ENV=production
APP_DEBUG=false
# The public origin of the API once a domain exists (https://...). Placeholder until then.
APP_URL=http://localhost:8080
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# MySQL 8.4 LTS. "mysql" is the bundled service (profile bundled-db); for a managed MySQL set its
# host, and its CA certificate in MYSQL_ATTR_SSL_CA when TLS is required. The application user
# has SELECT, INSERT, UPDATE, DELETE only; migrations run as a separate user (service migrate).
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=solveit_indonesia
DB_USERNAME=solveit_app
# MYSQL_ATTR_SSL_CA=

# Rate-limit counters live in the database cache table; no Redis, no queue worker, no scheduler.
CACHE_STORE=database
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Same origin (the gateway serves the website and /api): no browser origin needs CORS. With a
# separate API origin, list the exact website origin(s) here. Never "*".
CORS_ALLOWED_ORIGINS=
# Addresses of a proxy or load balancer in front of the gateway whose X-Forwarded-* headers are
# trusted. Empty when the gateway receives visitors directly (it passes their address itself).
TRUSTED_PROXIES=

INQUIRY_RATE_LIMIT_PER_MINUTE=5
INQUIRY_RATE_LIMIT_PER_HOUR=20
INQUIRY_MAX_BODY_BYTES=65536
