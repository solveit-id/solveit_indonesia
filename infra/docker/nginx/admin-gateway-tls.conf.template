# TLS for the private admin listener, added by compose.prod.admin-tls.yaml (B3.2d, not
# deployed). Certificate and key are Docker secrets; no certificate for a real domain exists.
# Rendered like nginx/admin-gateway.conf.template (same ${SOLVEIT_ADMIN_HOST}), same routes.

server {
    # Unknown or missing SNI: the handshake is refused, so no certificate is shown to scanners.
    listen 8443 ssl default_server;
    http2 on;
    server_name _;
    server_tokens off;
    ssl_reject_handshake on;
    default_type application/json;
    return 421 '{"message":"Misdirected Request."}';
}

server {
    listen 8443 ssl;
    http2 on;
    server_name ${SOLVEIT_ADMIN_HOST};

    ssl_certificate /run/secrets/admin_tls_certificate;
    ssl_certificate_key /run/secrets/admin_tls_private_key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SolveitAdminTls:1m;
    ssl_session_timeout 1h;
    ssl_session_tickets off;

    include /etc/nginx/solveit/admin-gateway-routes.conf;
}
