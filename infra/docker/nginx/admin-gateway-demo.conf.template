# Local team demo only (B5a, compose.prod.demo.yaml): rendered next to admin-gateway.conf by the
# admin listener's entrypoint. A Quick Tunnel host (https://<four-random-words>.trycloudflare.com)
# can be longer than nginx's default server name hash bucket (32 or 64 bytes, by CPU), and nginx
# then refuses to start ("could not build server_names_hash"). Found by the Docker CI demo job.
server_names_hash_bucket_size 128;
