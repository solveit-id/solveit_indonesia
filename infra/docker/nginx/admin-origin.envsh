#!/bin/sh
# Sourced by the entrypoint of the admin listener (compose.prod.yaml, service admin-gateway)
# before the nginx image renders /etc/nginx/templates with envsubst. B3.2d, not deployed.
#
# The admin host comes from ADMIN_URL, the value Laravel's AdminRequestBoundary checks Host and
# Origin against, so the listener and the API can never disagree about the admin origin. The
# container stops (fails closed) unless ADMIN_URL is an https:// origin: the session cookie is
# Secure and __Host- only then (backend config/session.php). Both values end up inside nginx
# configuration, so they are validated strictly before anything is rendered.
# shellcheck shell=sh

solveit_admin_refuse() {
    echo "solveit: $*" >&2
    exit 1
}

solveit_admin_url="${ADMIN_URL:-}"
solveit_admin_url="${solveit_admin_url%/}"

# Lowercase host name with at least one dot, optional port, nothing else (no path, no user).
if ! printf '%s' "$solveit_admin_url" \
    | grep -Eqx 'https://[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+(:[0-9]{1,5})?'; then
    solveit_admin_refuse "ADMIN_URL must be the https:// origin of the admin console (lowercase host, optional port, no path)"
fi

solveit_admin_authority="${solveit_admin_url#https://}"
SOLVEIT_ADMIN_HOST="${solveit_admin_authority%%:*}"

# Address of a TLS-terminating proxy in front of the plain listener whose X-Forwarded-For is
# trusted (one IP or CIDR). The default trusts nobody: no connection to the listener comes from
# the container's own loopback.
SOLVEIT_ADMIN_REAL_IP_FROM="${SOLVEIT_ADMIN_REAL_IP_FROM:-127.0.0.1/32}"
if ! printf '%s' "$SOLVEIT_ADMIN_REAL_IP_FROM" | grep -Eqx '[0-9A-Fa-f:.]+(/[0-9]{1,3})?'; then
    solveit_admin_refuse "SOLVEIT_ADMIN_REAL_IP_FROM must be one IP address or CIDR range"
fi

export SOLVEIT_ADMIN_HOST SOLVEIT_ADMIN_REAL_IP_FROM
unset solveit_admin_url solveit_admin_authority
