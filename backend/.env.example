APP_NAME="Solveit Indonesia"
APP_ENV=local
APP_KEY=
# Must be false outside local development: debug mode adds stack traces to error responses.
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Use "info" or higher outside local development.
LOG_LEVEL=debug

# Local development uses SQLite (database/database.sqlite, ignored by Git).
# The production database is not decided yet; see backend/README.md.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=solveit_indonesia
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Also stores rate-limit counters. "database" works without Redis.
CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Solveit API ---

# Browser origins allowed to call /api/* (comma-separated, exact scheme://host:port).
# Local: the Vite dev server and the static preview. Add the production website origin
# once the domain is decided. Never use "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Load balancer or CDN addresses whose X-Forwarded-* headers are trusted
# (comma-separated IPs or CIDR ranges). Empty trusts no proxy.
TRUSTED_PROXIES=

# POST /api/v1/inquiries limits per client IP. Every attempt counts.
INQUIRY_RATE_LIMIT_PER_MINUTE=5
INQUIRY_RATE_LIMIT_PER_HOUR=20
# Maximum request body in bytes (413 above it).
INQUIRY_MAX_BODY_BYTES=65536

# --- Laravel Boost (development only; the package is absent with composer install --no-dev) ---
# BOOST_ENABLED=true
# BOOST_RULES_ENABLED=true
