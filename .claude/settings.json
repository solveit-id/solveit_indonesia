{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run build)",
      "Bash(npm run test:e2e)",
      "Bash(npm run check)",
      "Bash(npm run format:check)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(php artisan test:*)",
      "Bash(php artisan route:list:*)",
      "Bash(vendor/bin/pint:*)",
      "Bash(composer validate:*)",
      "Bash(composer audit:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.backup)",
      "Read(./**/.env.bak)",
      "Read(./**/.env.dev)",
      "Read(./**/.env.development)",
      "Read(./**/.env.prod)",
      "Read(./**/.env.production)",
      "Read(./**/.env.staging)",
      "Read(./**/.env.test)",
      "Read(./**/.env.testing)",
      "Read(./**/production.env)",
      "Read(./**/secrets/**)",
      "Read(./**/auth.json)"
    ]
  },
  "enabledMcpjsonServers": ["playwright", "laravel-boost"]
}
